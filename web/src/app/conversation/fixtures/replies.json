          "text": "profit margin",
          "outcome": "asked",
          "reason": null,
          "ask": {
            "ask_id": "a1",
            "kind": "clarification",
            "question": "Which profit margin do you mean? They can differ by twenty points or more on the same company.",
            "options": [
              {
                "option_id": "o1",
                "label": "Gross margin",
                "description": "Revenue minus the direct cost of producing it. Shows pricing power and production efficiency."
              },
              {
                "option_id": "o2",
                "label": "Operating margin",
                "description": "Profit after operating costs but before interest and tax. Shows whether the core business works."
              },
              {
                "option_id": "o3",
                "label": "Net profit margin",
                "description": "What is left after everything, including interest and tax. The conventional reading of a bare \"profit margin\"."
              }
            ]
          }
        }
      ],
      "answer": null,
      "status": "asked"
    }
