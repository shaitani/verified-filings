# Copy this file to .env and adjust values for your local setup.

# SQLAlchemy async connection URL for the local PostgreSQL container.
# Scheme must be postgresql+asyncpg:// (the project uses the asyncpg driver).
#
# Host is "localhost" because Python runs on Windows, outside Docker.
# (pgAdmin, which runs inside the Docker network, uses host "db" instead.)
# User / password / db name below match docker-compose.dev.yml.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/verified_filings

# Separate PostgreSQL container (docker-compose service "db-test"), used only
# by tests/. Same credentials, different port (5433, not 5432) and database.
DATABASE_URL_TEST=postgresql+asyncpg://postgres:postgres@localhost:5433/verified_filings_test

# Read-only logins, one per read-only consumer. Create them with:
#   uv run python -m app.db.roles
DATABASE_URL_QUERY_MAPPER=postgresql+asyncpg://vf_query_mapper_role:mapper-password@localhost:5432/verified_filings
DATABASE_URL_RETRIEVAL=postgresql+asyncpg://vf_retrieval_role:retrieval-password@localhost:5432/verified_filings

# The Web Server's login -- it writes, and only in the "web" schema. Leave unset
# until the "web" migrations have run: its grants name those tables, and
# `app.db.roles` skips a role with no URL.
# DATABASE_URL_WEB=postgresql+asyncpg://vf_web_role:web-password@localhost:5432/verified_filings

# The admin routes' login: invites, traces, deleting a reader -- what the Web
# Server's own login must not do. The Web Server will not start without it.
# DATABASE_URL_ADMIN=postgresql+asyncpg://vf_admin_role:admin-password@localhost:5432/verified_filings

# Sign-in (app/api/auth.py). Four signing secrets, each at least 32 characters;
# the Web Server refuses to start without them. Generate all four at once:
#   uv run python -c "import secrets; [print(f'{n}={secrets.token_urlsafe(32)}') for n in ('AUTH_RESET_SECRET', 'AUTH_VERIFY_SECRET', 'AUTH_OAUTH_STATE_SECRET', 'AUTH_DEVICE_SECRET')]"
# AUTH_RESET_SECRET=
# AUTH_VERIFY_SECRET=
# AUTH_OAUTH_STATE_SECRET=
# AUTH_DEVICE_SECRET=

# GitHub sign-in, optional: a GitHub OAuth App (not a GitHub App). Without both
# values GitHub is simply not offered.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
#
# Where GitHub sends the browser back: the Web Client's page, which hands the
# result to the API. The same address must be listed as a callback URL on the
# GitHub OAuth App, and the browser must use the same host (localhost, not
# 127.0.0.1): the sign-in's CSRF cookie belongs to the host it started on.
# GITHUB_OAUTH_REDIRECT_URL=http://localhost:4200/auth/github/callback

# Optional, with their defaults:
# AUTH_SESSION_DAYS=30
# AUTH_COOKIE_SECURE=true

# Serve the API's own docs at /docs, /redoc and /openapi.json. Off by default so
# a deployed server never offers them; turn on for this machine only.
# API_DOCS=false

# Local Ollama embedding service (docker-compose service "ollama"), used to
# embed concept text and user questions for semantic search.
# Host is "localhost" for the same reason as DATABASE_URL above -- Python
# runs on Windows, outside Docker. 11434 is Ollama's standard port.
EMBEDDING_URL=http://localhost:11434
