# What api.Dockerfile's build never sees. Docker pairs an ignore file with a
# Dockerfile by name (<dockerfile>.dockerignore); it cannot be pointed at.
#
# Never in the image: secrets, data, local environments, history.
.env
.env.*
!.env.example
data/
.venv/
.git/
.pytest_cache/
.ruff_cache/
**/__pycache__/
*.pptx
~$*

# Not needed to serve.
tests/
evals/
*.md
!README.md
